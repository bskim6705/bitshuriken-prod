# Local exchange (bitshuriken-prod-be apps). Dev: direct ports.
SPOT_API=http://localhost:5101
PORTAL_API=http://localhost:5103

# Master account that owns the fly's subaccount (auto signup-or-login). The master never trades.
MASTER_EMAIL=fly-master@fly.local
MASTER_PASSWORD=flypassword123

# USDT moved master→subaccount when the fly's subaccount is created (dev deposit)
FLY_CAPITAL_USDT=100000
API_KEY_RECV_WINDOW_MS=15000

# Live loop: bar cadence + local klines poll interval
FLY_INTERVAL=1m
BAR_POLL_MS=2000

# Dashboard + JSON API (auth-less). FLY_HOST=0.0.0.0 to watch from the LAN / from the FE on another host.
FLY_PORT=5130
FLY_HOST=127.0.0.1

# Rate-limit exemption token (same value as the backend's RATE_LIMIT_INTERNAL_TOKEN). Empty = normal user traffic.
FLY_INTERNAL_TOKEN=

# Backtest fill model (Binance history via ccxt)
SIM_FEE_BPS=10
SIM_SLIPPAGE_BPS=2
# Actual taker fee of the fly's subaccount (bps) — used by evolution fitness + live lob sim. T0 = 10, T5 = 3.
FLY_TAKER_FEE_BPS=10

# Connectome / models / live state (gitignored)
DATA_DIR=./data

# docker compose (Mac mini 배포): 심볼·리그 크기·관전 바인드
FLY_SYMBOL=BTCUSDT
FLY_FLIES=8
FLY_SEASON_MIN=30
FLY_RELEGATE=3
FLY_MIN_TRADES=2
FLY_WORKERS=3
FLY_FIT_HOURS=2
FLY_BIND=127.0.0.1
