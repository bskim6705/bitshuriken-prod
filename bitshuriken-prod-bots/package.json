{
  "name": "bitshuriken-prod-bots",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Binance/Upbit-mirroring maker/taker bots + monetary-integrity checker for bitshuriken-prod. Bots are ordinary users (HMAC API keys); market-making accounts are rate-limit exempt.",
  "scripts": {
    "bots": "tsx src/run.ts",
    "check": "tsx src/integrity/check.ts",
    "check:watch": "tsx src/integrity/check.ts --watch",
    "scan": "tsx src/scan.ts",
    "fidelity": "tsx src/fidelity.ts",
    "bench": "tsx src/bench.ts",
    "sweep": "tsx src/sweep.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "ccxt": "^4.5.58",
    "dotenv": "^16.4.7",
    "pg": "^8.13.1",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/ws": "^8.18.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
