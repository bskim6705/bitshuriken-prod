# Local exchange (bitshuriken-prod-be apps). Dev: direct ports. In docker attached to
# bitshuriken_internal, override with internal DNS (http://be-spot:5101 등) — docker-compose.yml 참조.
SPOT_API=http://localhost:5101
FUTURES_API=http://localhost:5102
PORTAL_API=http://localhost:5103

# Master account that OWNS every agent subaccount (auto signup-or-login on boot).
# Each strategy runs as one subaccount under this master, funded by master→sub transfer,
# and trades with its own HMAC API key. The master never trades. (ADR-049 subaccounts.)
MASTER_EMAIL=agents-master@agents.local
MASTER_PASSWORD=agentspassword123

# Subaccount labelling + funding
AGENT_LABEL_PREFIX=agent            # subaccount label = <prefix>:<strategyId>:<symbol>:<shortId>
AGENT_CAPITAL_USDT=1000000          # USDT moved master→subaccount when an agent is created
API_KEY_RECV_WINDOW_MS=5000         # HMAC request recvWindow (max 60000)

# Control daemon (agentd) — the long-running fleet host + dashboard
CONTROL_HOST=127.0.0.1
CONTROL_PORT=5120
AGENTD_URL=http://127.0.0.1:5120    # MCP + CLI reach the daemon here

# Liquidity provisioning: activate tickers + spawn prod bots mirrors on demand
ADMIN_API_SECRET=                   # must match the backend's ADMIN_API_SECRET (X-Admin-Secret)
BOTS_DIR=../bitshuriken-prod-bots   # separate bots repo (not in this fork) spawned per-symbol; mirror만 필요

# Results store (JSON files) — agent snapshots + backtest run records
DATA_DIR=./data

# Live forward-test defaults
KLINE_INTERVAL=1m                   # bar cadence live agents decide on
BAR_POLL_MS=2000                    # how often the BarClock polls local klines for a new final bar

# Backtest / signal-discovery fill model (history pulled from Binance public data via ccxt)
SIM_FEE_BPS=10
SIM_SLIPPAGE_BPS=2
SIM_LATENCY_BARS=1

# Rate limit (ADR-060). 봇도 유저다 (feedback-025) — 기본은 일반 트래픽. 값을 BE의
# RATE_LIMIT_INTERNAL_TOKEN과 동일하게 두면 모든 요청에 X-Internal-Token을 첨부해 면제된다.
# 면제 정책(시장조성 계정 한정 vs 토큰)은 유저 확정 사항이라 기본 미설정(=inert).
AGENT_INTERNAL_TOKEN=
