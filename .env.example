# --- local exchange base URLs (dev: port-direct; prod: https://bitshuriken.com/api via nginx) ---
SPOT_API=http://localhost:5101
FUTURES_API=http://localhost:5102
PORTAL_API=http://localhost:5103

# --- integrity checker (npm run check) reads Postgres directly (read-only). ---
DATABASE_URL=postgresql://bitshuriken:bitshuriken@localhost:5110/bitshuriken

# --- market-making bot identities (auto signup + HMAC key on boot) ---
MAKER_EMAIL=maker-bot@bots.local
TAKER_EMAIL=taker-bot@bots.local
BOT_PASSWORD=botpassword123

# --- rate-limit exemption for market-making accounts (ADR-066 / feedback-025) ---
# The bot sets User.rateLimitExempt on its maker+taker accounts at boot via the admin
# surface (X-Admin-Secret). Must equal the BE ADMIN_API_SECRET. If empty, the bot skips
# exemption (works only while RATE_LIMIT_ENABLED=false).
ADMIN_API_SECRET=

# --- symbol selection (empty = mirror every ticker the exchange lists). ---
# Quote asset routes the feed: USDT/USDC -> Binance, KRW -> Upbit.
SPOT_SYMBOLS=
FUTURES_SYMBOLS=

# --- tuning ---
DEPTH_LEVELS=20
RECONCILE_MS=1500
QTY_TOLERANCE=0.2
TAKER_MAX_QTY_FRAC=0.6
TAKER_MAX_TPS=8
FUTURES_LEVERAGE=10
FUTURES_MAX_NOTIONAL=1000000
