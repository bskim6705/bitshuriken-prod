# ============================================================================
# bitshuriken prod env. Copy to `.env.prod` on the host and fill in.
# NEVER commit .env.prod. Generate secrets with: openssl rand -hex 32
# ============================================================================

# ---- Domain (nginx routing + mail links) ----
DOMAIN=bitshuriken.com

# ---- Postgres ----
POSTGRES_USER=bitshuriken
POSTGRES_PASSWORD=CHANGE_ME_strong_password
POSTGRES_DB=bitshuriken
# Must match the three vars above. Internal docker host = postgres:5432.
DATABASE_URL=postgresql://bitshuriken:CHANGE_ME_strong_password@postgres:5432/bitshuriken

# ---- Messaging ----
KAFKA_BROKER=kafka:9092
# Partition count = bucket count P (NOT ticker count). Symbols are assigned to
# buckets by FNV-1a(symbol) % P, so this is fixed regardless of how many tickers
# exist. Keep in sync with the match engine's P (default 6).
MATCH_SPOT_PARTITIONS=6
MATCH_FUTURES_PARTITIONS=6

# ---- BE app ports (internal; nginx upstreams point at these) ----
PORT_SPOT=5101
PORT_FUTURES=5102
PORT_PORTAL=5103
PORT_SETTLE=5104

# ---- Auth / session (every app shares these) ----
JWT_SECRET=CHANGE_ME_openssl_rand_hex_32
API_KEY_ENCRYPTION_KEY=CHANGE_ME_openssl_rand_hex_32
# Allowed browser origins (exact match, credentials: true). The FE origin.
CORS_ORIGINS=https://bitshuriken.com

# ---- Admin ----
ADMIN_EMAIL=admin@bitshuriken.com
ADMIN_API_SECRET=CHANGE_ME_openssl_rand_hex_32

# ---- Mail (Gmail SMTP) ----
# Requires 2FA on the Google account + an App Password (16 chars). Use the app
# password as SMTP_PASS, NOT your normal account password. MAIL_FROM must be the
# authenticated Gmail address (or a configured alias).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=no-reply@bitshuriken.com
SMTP_PASS=CHANGE_ME_gmail_app_password
MAIL_FROM=no-reply@bitshuriken.com
APP_BASE_URL=https://bitshuriken.com

# ---- Rate limit (ADR-060) ----
RATE_LIMIT_ENABLED=false
# Behind nginx (maps Cloudflare's real IP) = 1 proxy hop; trust exactly 1 so req.ip is real.
RATE_LIMIT_TRUST_PROXY_HOPS=1
# Exemption is X-Internal-Token only (test harness attaches it). Empty = no exemption.
RATE_LIMIT_INTERNAL_TOKEN=