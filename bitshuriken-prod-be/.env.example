# Copy to .env and fill in. 모든 값은 부팅 시 검증 — 없으면 앱이 부팅에 실패한다.

# ── Ports ── (백엔드 5101~5109 / 인프라 5110~: 5110=postgres, 5113=Kafka, 5114=Zookeeper)
PORT_SPOT=5101
PORT_FUTURES=5102
PORT_PORTAL=5103
# settle 티어(정산 프로세스, M1) — 헬스 전용 HTTP. exchange.sh가 :5104를 검증한다.
PORT_SETTLE=5104

# ── Database / messaging ──
# DB는 localhost:5110 (로컬 5432 postgres와 충돌 회피). docker compose up -d 로 기동.
DATABASE_URL="postgresql://bitshuriken:bitshuriken@localhost:5110/bitshuriken"
KAFKA_BROKER="localhost:5113"

# ── Auth / session ──
# 전 앱이 동일 JWT_SECRET 공유 (발급=portal, 검증=전 앱). prod에선 강한 랜덤 값으로 교체.
JWT_SECRET="change-me"
# Comma-separated list of allowed browser origins. Exact match. credentials: true.
CORS_ORIGINS="http://localhost:5100"

# ── API key / TOTP secret 암호화 (AES-256-GCM, 32 bytes hex) ──
# 생성: openssl rand -hex 32 — 전 앱이 동일 값 공유.
API_KEY_ENCRYPTION_KEY="<openssl rand -hex 32 here>"

# ── Admin (둘 다 선택 — 부팅 검증 대상 아님) ──
# prisma db seed가 ADMIN으로 승격할 이메일 (기본 admin@test.com / 비번 password123).
ADMIN_EMAIL="admin@test.com"
# 스크립트/봇이 ticker 운영(리스팅/디리스팅/상태/생성)을 호출할 때 쓰는 service secret.
# 설정 시에만 X-Admin-Secret 경로 활성(미설정이면 세션 admin만). 생성: openssl rand -hex 32
ADMIN_API_SECRET="<openssl rand -hex 32 here>"

# ── Mail (portal) — Gmail SMTP ──
# Gmail은 2FA 켠 계정의 App Password 필요(일반 비번 아님). MAIL_FROM은 인증 계정
# (또는 Send-As로 검증된 별칭)이어야 한다. 커스텀 도메인 발신은 Google Workspace 권장.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE="false"          # 587=STARTTLS=false, 465=true
SMTP_USER="you@bitshuriken.com"
SMTP_PASS="<gmail app password>"
MAIL_FROM="no-reply@bitshuriken.com"
# 메일 링크 base (FE origin) — verify-email / reset-password 링크에 사용
APP_BASE_URL="http://localhost:5100"

# ── Rate limit (ADR-060) ── 환경/배포별 값만 여기. 수치 한도(weight/orders/raw)는 코드(rate-limit.defaults). feedback-020.
# Phase 1은 OFF로 출시(헤더/rateLimits[]만 방출). 봇/에이전트/하니스 백오프 후 demo 프로파일에서만 true.
RATE_LIMIT_ENABLED=false
# 역프록시 뒤일 때만 hop>0. 0 = X-Forwarded-For 신뢰 안 함(req.ip 스푸핑 차단).
RATE_LIMIT_TRUST_PROXY_HOPS=0
# 면제: X-Internal-Token 일치 시에만(공개 엔드포인트도 커버). 미설정이면 면제 없음.
# 생성: openssl rand -hex 32. 봇/에이전트/하니스가 모든 요청에 X-Internal-Token으로 첨부.
RATE_LIMIT_INTERNAL_TOKEN=""
# 선택: 인메모리 카운터 Map 상한(다수 IP 폭주 OOM 방지). 미설정 시 100000.
# RATE_LIMIT_STORE_MAX_KEYS=100000
