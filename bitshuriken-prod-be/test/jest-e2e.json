{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "forceExit": true,
  "testTimeout": 60000,
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^@app/shared/(.*)$": "<rootDir>/../libs/shared/src/$1",
    "^@app/infra/(.*)$": "<rootDir>/../libs/infra/src/$1",
    "^@app/core-domain/(.*)$": "<rootDir>/../libs/core-domain/src/$1"
  }
}
